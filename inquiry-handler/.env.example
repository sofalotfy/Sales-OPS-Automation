APP_NAME="Inquiry Handler"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Scoped factor/classification store (feature 006); only this service uses it
# (research R8). Tests run on SQLite :memory: (phpunit.xml), never this store.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=inquiry_handler
DB_USERNAME=rag
DB_PASSWORD=rag

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
# Async CRM ingest (feature 013): jobs are processed by the `inquiry-worker`
# container against the Redis queue. redis cache store keeps the throttle
# counters and the AI throughput guard shared across the whole worker fleet.
# Keep these `redis` in every runtime container (worker AND web) so the guard
# is a single global budget, not a per-process one.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PORT=6379
# predis (pure-PHP) is used because the php:8.4-cli runtime image has no
# phpredis extension compiled in (research R1). Laravel reads REDIS_CLIENT from
# config/database.php; `predis` needs no Dockerfile build changes.
REDIS_CLIENT=predis
# Redis retry_after MUST stay above the worker timeout (600s) and the job
# timeout (590s): a long web-research run must never have its lease stolen by a
# re-dispatch (research R3). If research budgets are raised, raise this ladder.
REDIS_QUEUE_RETRY_AFTER=900

# CRM ingest API (feature 013): shared credential for POST /inquiry/enqueue and
# GET /inquiry/{id}. NEVER commit a real key. Per-key throttle window.
CRM_API_KEY=
CRM_RATE_MAX_PER_MIN=120

# Global AI throughput guard (feature 013): a shared per-minute request budget
# and in-flight cap across all workers so the fleet never collectively exceeds
# the provider's free tier. The Groq key ceiling is ~1000 RPM / 8K TPM — the
# binding constraint is tokens-per-minute, not requests; RPM is set high so a
# single research-heavy run's note batches never hit a phantom request wall,
# and concurrency keeps each concurrent wave under the 8K TPM window. Gated so
# feature tests stay off.
AI_GUARD_ENABLED=true
AI_MAX_PER_MIN=150
AI_MAX_INFLIGHT=4
# How long a notes batch waits for a freed guard slot before failing open
# (90s spans one RPM window; batches slow down under load instead of dropping).
AI_GUARD_WAIT_SECONDS=90

# Upstream services (Docker Compose internal DNS in the container; host names locally)
AUTH_API_URL=http://auth-service:8001
RAG_API_URL=http://work-scope-rag:8000

# AI provider (Groq serving the GPT-OSS model family). NEVER commit a real key.
# Free tier: the binding ceilings are ~8K tokens/min per model (TPM, handled via
# 413/429 + retry) AND a hard daily token budget (TPD, ~200K/day on on-demand) —
# once the daily quota is spent, EVERY call returns 429 until the window resets;
# the code detects the `tokens per day` body, skips the pointless retry, and logs
# a distinct ERROR. requests-per-minute is generous (~1000), so the local guard's
# RPM cap is set high (150) purely as a sanity bound, never a practical wall.
AI_API_KEY=
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# Groq rejects response_format=json_object for gpt-oss-20b (400 json_validate_failed);
# gpt-oss-120b handles JSON mode reliably, so all roles point at it.
AI_MODEL=openai/gpt-oss-120b
AI_RESEARCH_MODEL=openai/gpt-oss-120b
AI_FILTER_MODEL=openai/gpt-oss-120b
AI_CONCURRENCY=2
AI_MAX_OUTPUT_TOKENS=2048
AI_TIMEOUT=90

# Service account used to obtain the RAG bearer token (auth-service login).
SERVICE_USERNAME=
SERVICE_PASSWORD=

# Booking link for the booking disposition (FR-008); if unset, booking escalates (FR-009).
BOOKING_URL=

# Triage tunables
MESSAGE_MAX_LENGTH=4000
RAG_TOP_K=5
SCOPE_GATE_ENABLED=true

# Pre-classification web research (company + person lookup). Defaults to the
# Tavily-backed TavilyResearchProvider. Point WEB_RESEARCH_PROVIDER at a
# custom App\WebResearch\WebResearchProvider implementation to swap it.
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_PROVIDER=

# Web research — Tavily search API (company/person lookup). NEVER commit a real key.
# Max results per research topic is set per-topic in ./TavilyResearchProvider.php.
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=basic

# Web research — AI research agent budgets (feature 010/011). Everyday defaults;
# lower them to trim cost/latency, raise them for deeper research.
WEB_RESEARCH_MAX_CANDIDATES=40
WEB_RESEARCH_MAX_SOURCES=40
WEB_RESEARCH_FETCH_TIMEOUT=8
WEB_RESEARCH_FETCH_CONCURRENCY=10
WEB_RESEARCH_FETCH_MAX_BYTES=200000
WEB_RESEARCH_SOURCE_MAX_CHARS=8000
WEB_RESEARCH_SUMMARY_MAX_INPUT_CHARS=8000
WEB_RESEARCH_STEP_TIMEOUT=90
# AI filter retries when the model returns unparseable output (free tier);
# the best-effort name-match rescue for small companies with scarce data; the
# layer-1 (per-page notes) retries; and the notes output cap (bounds each note's
# kept text ~4 chars/token and keeps every layer-1 call inside the free tier's
# 8K token-per-minute window). Both research layers EXTRACT all stated detail
# rather than condensing it, so no information is dropped (feature 011).
WEB_RESEARCH_FILTER_ATTEMPTS=2
WEB_RESEARCH_NOTE_ATTEMPTS=2
WEB_RESEARCH_NOTE_MAX_OUTPUT_TOKENS=1024
WEB_RESEARCH_RESCUE_ON_NAME_MATCH=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="sales@localhost"