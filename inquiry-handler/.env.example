APP_NAME="Inquiry Handler"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8003

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Scoped factor/classification store (feature 006); only this service uses it
# (research R8). Tests run on SQLite :memory: (phpunit.xml), never this store.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=inquiry_handler
DB_USERNAME=rag
DB_PASSWORD=rag

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Upstream services (Docker Compose internal DNS in the container; host names locally)
AUTH_API_URL=http://auth-service:8001
RAG_API_URL=http://work-scope-rag:8000

# AI provider (Z.AI, GLM open-source model family). NEVER commit a real key.
ZAI_API_KEY=
ZAI_MODEL=glm-4.5-flash
ZAI_RESEARCH_MODEL=glm-4.7-flash
ZAI_TIMEOUT=90
ZAI_API_URL=https://api.z.ai/api/paas/v4/chat/completions

# Deployment-specific company/scope statement injected into the fixed system
# prompt; keep it aligned with the retrieval corpus loaded in work-scope-rag.
COMPANY_SCOPE="a B2B software-automation consultancy that builds enterprise web applications, automation workflows, and sales/CRM tooling for B2B software companies"

# Service account used to obtain the RAG bearer token (auth-service login).
SERVICE_USERNAME=
SERVICE_PASSWORD=

# Booking link for the booking disposition (FR-008); if unset, booking escalates (FR-009).
BOOKING_URL=

# Triage tunables
MESSAGE_MAX_LENGTH=4000
RAG_TOP_K=5
SCOPE_GATE_ENABLED=true

# Pre-classification web research (company + person lookup). Defaults to the
# Tavily-backed TavilyResearchProvider. Point WEB_RESEARCH_PROVIDER at a
# custom App\WebResearch\WebResearchProvider implementation to swap it.
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_PROVIDER=

# Web research — Tavily search API (company/person lookup). NEVER commit a real key.
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5

# Web research — AI research agent budgets (feature 010). Everyday defaults;
# lower them to trim cost/latency, raise them for deeper research.
WEB_RESEARCH_MAX_CANDIDATES=12
WEB_RESEARCH_MAX_SOURCES=5
WEB_RESEARCH_FETCH_TIMEOUT=8
WEB_RESEARCH_FETCH_MAX_BYTES=200000
WEB_RESEARCH_SOURCE_MAX_CHARS=8000
WEB_RESEARCH_SUMMARY_MAX_INPUT_CHARS=24000
WEB_RESEARCH_STEP_TIMEOUT=25
# AI filter retries when the model returns unparseable output (free tier);
# and the best-effort name-match rescue for small companies with scarce data.
WEB_RESEARCH_FILTER_ATTEMPTS=2
WEB_RESEARCH_RESCUE_ON_NAME_MATCH=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="sales@localhost"