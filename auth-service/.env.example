# Environment variables for auth-service
# Copy to .env and adjust for your environment.
# NEVER commit the real .env — it contains the bootstrap admin password.

# PostgreSQL connection (Docker Compose default; dedicated auth database)
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/auth

# Bootstrap administrator, seeded only when the users table is empty.
# The service refuses to start with an empty users table and missing credentials.
AUTH_INITIAL_ADMIN_USERNAME=admin
AUTH_INITIAL_ADMIN_PASSWORD=change-me-to-a-strong-password

# Token lifetime in seconds (default: 90 days = 7776000). Set very small in dev
# to exercise expiry quickly (see quickstart.md scenario 7).
AUTH_TOKEN_EXPIRY_SECONDS=7776000