# Environment variables for work-scope-rag
# Copy to .env and adjust for your environment.

# PostgreSQL / pgvector connection (Docker Compose default)
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag

# auth-service introspection endpoint (Docker Compose default)
AUTH_SERVICE_URL=http://auth-service:8001

# Sentence-transformers model used for embeddings and chunking
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Max upload size per document file, in MB
MAX_FILE_SIZE_MB=10