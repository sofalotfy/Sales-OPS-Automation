APP_NAME="Sales Ops Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8002

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This dashboard is a pure HTTP consumer: no database, sessions in files.
DB_CONNECTION=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Upstream services (Docker Compose internal DNS in the container; host names locally)
AUTH_API_URL=http://auth-service:8001
RAG_API_URL=http://work-scope-rag:8000
INQUIRY_HANDLER_URL=http://inquiry-handler:8003

MAIL_MAILER=log
MAIL_FROM_ADDRESS="admin@localhost"